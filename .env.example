# Copiá a `.env` (local) o configurá las mismas variables en Vercel.

DATABASE_URL=postgresql://...
AUTH_SECRET=generá_un_secreto_largo_aleatorio

# neon | sheet
SHOP_CATALOG_SOURCE=neon

# Solo si SHOP_CATALOG_SOURCE=sheet
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_GID=0

# Contacto (Resend)
# RESEND_API_KEY=
# CONTACT_EMAIL_TO=

# Mercado Pago — Checkout Pro (server action create-mp-preference)
# Pruebas: Access Token de prueba (TEST-...) desde developers.mercadopago.com
MERCADOPAGO_ACCESS_TOKEN=
# URL pública del sitio (back_urls después del pago).
# Local con credencial de PRODUCCIÓN: usá HTTPS (ej. URL de Vercel o túnel ngrok), no solo localhost.
# Local con token TEST-: http://localhost:3000 suele alcanzar.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Opcional: IPN (si no se define, usa https://tu-dominio/api/mercadopago/webhook)
# MERCADOPAGO_NOTIFICATION_URL=https://tu-dominio.vercel.app/api/mercadopago/webhook
